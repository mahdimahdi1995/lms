    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cb0c5057-8a61-4c2c-bc9f-3e76717cb6f9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
